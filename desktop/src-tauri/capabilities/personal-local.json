{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "personal-local",
  "description": "Personal package exposes only local Personal Mode commands.",
  "local": true,
  "remote": null,
  "windows": ["main"],
  "permissions": [
    "allow-desktop-status", "allow-desktop-unlock", "allow-desktop-lock",
    "allow-desktop-reflection-create", "allow-desktop-reflection-list", "allow-desktop-reflection-get", "allow-desktop-reflection-add-turn", "allow-desktop-reflection-close", "allow-desktop-reflection-delete", "allow-desktop-reflection-search",
    "allow-desktop-exploration-start", "allow-desktop-exploration-get", "allow-desktop-exploration-answer", "allow-desktop-exploration-skip",
    "allow-desktop-formulation-propose", "allow-desktop-formulation-correct", "allow-desktop-formulation-accept", "allow-desktop-formulation-reject",
    "allow-desktop-personal-backup", "allow-desktop-personal-restore-isolated", "allow-desktop-personal-export-owner", "allow-desktop-personal-rotate", "allow-desktop-personal-recovery-status",
    "allow-desktop-ai-provider-status", "allow-desktop-ai-provider-configure", "allow-desktop-ai-provider-delete", "allow-desktop-ai-formulation-prepare", "allow-desktop-ai-formulation-execute",
    "allow-desktop-ai-interview-status", "allow-desktop-ai-interview-policy", "allow-desktop-ai-interview-source-policy", "allow-desktop-ai-interview-start", "allow-desktop-ai-interview-list", "allow-desktop-ai-interview-grant-consent", "allow-desktop-ai-interview-revoke-consent", "allow-desktop-ai-interview-first-question", "allow-desktop-ai-interview-submit", "allow-desktop-ai-interview-retry", "allow-desktop-ai-interview-control", "allow-desktop-ai-interview-get", "allow-desktop-ai-interview-disclosure", "allow-desktop-ai-model-list", "allow-desktop-ai-model-correct", "allow-desktop-ai-change-list", "allow-desktop-ai-change-control", "allow-desktop-ai-change-observe", "allow-desktop-ai-change-allow-observations", "allow-desktop-ai-change-start-review",
    "allow-desktop-sleep-source-status", "allow-desktop-sleep-configure-inbox", "allow-desktop-sleep-scan", "allow-desktop-sleep-history", "allow-desktop-sleep-delete-record"
  ]
}
