{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local",
  "description": "Packaged local main window may invoke only bounded PSYCHE OS E02, E03, and V3-A0 commands.",
  "local": true,
  "remote": null,
  "windows": ["main"],
  "permissions": [
    "allow-desktop-status",
    "allow-desktop-unlock",
    "allow-desktop-lock",
    "allow-desktop-correct",
    "allow-desktop-plan-deletion",
    "allow-desktop-execute-deletion",
    "allow-desktop-backup-status",
    "allow-desktop-verify-backup",
    "allow-desktop-validate-recovery",
    "allow-desktop-activate-recovery",
    "allow-desktop-preview-export",
    "allow-desktop-execute-export",
    "allow-desktop-archive-operate",
    "allow-desktop-archive-timeline",
    "allow-desktop-archive-explorer",
    "allow-desktop-archive-snapshot-diff",
    "allow-desktop-archive-execute-deletion",
    "allow-desktop-reflection-create",
    "allow-desktop-reflection-list",
    "allow-desktop-reflection-get",
    "allow-desktop-reflection-add-turn",
    "allow-desktop-reflection-close",
    "allow-desktop-reflection-delete"
  ]
}
