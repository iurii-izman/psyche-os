{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "lifecycle", "candidate", "profile_binding", "identities", "evidence", "reviews", "boundary_assessments", "rdg_controls", "residual_risks", "gate_decision", "successor", "seal"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evaluation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
    "lifecycle": {"enum": ["DRAFT", "SEALED"]},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["source_commit", "build_id", "platform", "requested_data_class", "reproducibility"], "properties": {"source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "build_id": {"type": "string", "minLength": 1}, "platform": {"type": "object", "additionalProperties": false, "required": ["operating_system", "architecture", "runtime", "packaging"], "properties": {"operating_system": {"type": "string", "minLength": 1}, "architecture": {"type": "string", "minLength": 1}, "runtime": {"type": "string", "minLength": 1}, "packaging": {"type": "string", "minLength": 1}}}, "requested_data_class": {"enum": ["SYNTHETIC_ONLY", "REAL_PERSONAL"]}, "reproducibility": {"type": "object", "additionalProperties": false, "required": ["status", "evidence_ids"], "properties": {"status": {"enum": ["REPRODUCED", "NOT_REPRODUCED", "UNKNOWN"]}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}}}},
    "profile_binding": {"type": "object", "additionalProperties": false, "required": ["profile_path", "profile_id", "profile_version", "profile_definition_sha256", "profile_source_commit"], "properties": {"profile_path": {"type": "string"}, "profile_id": {"type": "string"}, "profile_version": {"type": "string"}, "profile_definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "profile_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "identities": {"type": "object", "additionalProperties": false, "required": ["lock", "sbom", "artifacts"], "properties": {"lock": {"$ref": "#/$defs/identity"}, "sbom": {"$ref": "#/$defs/identity"}, "artifacts": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/identity"}, {"required": ["id"]}]}}}},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "rdg_ids", "proof_class", "proof_result", "candidate_source_commit", "candidate_build_id", "candidate_platform", "raw_evidence_path", "raw_evidence_sha256", "expires_at"], "properties": {"id": {"type": "string"}, "rdg_ids": {"type": "array", "items": {"type": "string"}}, "proof_class": {"enum": ["deterministic_validator_result_v1", "boundary_exclusion_proof_v1"]}, "proof_result": {"enum": ["PASS", "FAIL", "INCOMPLETE", "UNKNOWN"]}, "candidate_source_commit": {"type": "string"}, "candidate_build_id": {"type": "string"}, "candidate_platform": {"type": "object"}, "raw_evidence_path": {"type": "string"}, "raw_evidence_sha256": {"type": "string"}, "expires_at": {"type": "string"}}}},
    "reviews": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "boundary_id", "review_class", "candidate_source_commit", "candidate_build_id", "candidate_platform", "state", "expires_at", "findings"], "properties": {"id": {"type": "string"}, "boundary_id": {"type": "string"}, "review_class": {"type": "string"}, "candidate_source_commit": {"type": "string"}, "candidate_build_id": {"type": "string"}, "candidate_platform": {"type": "object"}, "state": {"type": "string"}, "expires_at": {"type": "string"}, "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["severity", "state"], "properties": {"severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]}, "state": {"type": "string"}}}}}}},
    "boundary_assessments": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["boundary_id", "state", "unreachable", "review_ids", "exclusion_evidence_ids"], "properties": {"boundary_id": {"type": "string"}, "state": {"enum": ["APPLICABLE", "EXCLUDED"]}, "unreachable": {"type": "boolean"}, "review_ids": {"type": "array", "items": {"type": "string"}}, "exclusion_evidence_ids": {"type": "array", "items": {"type": "string"}}}}},
    "rdg_controls": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "boundary_predicates", "evidence_ids", "excluded_boundary_ids"], "properties": {"id": {"type": "string"}, "status": {"type": "string"}, "boundary_predicates": {"type": "array", "items": {"type": "string"}}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "excluded_boundary_ids": {"type": "array", "items": {"type": "string"}}}}},
    "residual_risks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "severity", "status", "expires_at"], "properties": {"id": {"type": "string"}, "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]}, "status": {"enum": ["OPEN", "RESOLVED", "UNKNOWN"]}, "expires_at": {"type": "string"}}}},
    "gate_decision": {"type": "object", "additionalProperties": false, "required": ["requested_state", "authority"], "properties": {"requested_state": {"enum": ["CLOSED", "OPEN"]}, "authority": {"type": "string"}}},
    "successor": {"type": "object", "additionalProperties": false, "required": ["supersedes", "invalidation_reasons"], "properties": {"supersedes": {"type": ["string", "null"]}, "invalidation_reasons": {"type": "array", "items": {"type": "string"}}}},
    "seal": {"type": ["object", "null"], "properties": {"payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "sealed_at": {"type": "string"}}, "required": ["payload_sha256", "sealed_at"], "additionalProperties": false}
  },
  "$defs": {"identity": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
