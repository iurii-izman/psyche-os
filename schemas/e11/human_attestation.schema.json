{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "sealed_evaluation_sha256", "method", "attestor_kind", "decision", "attested_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evaluation_id": {"type": "string"},
    "sealed_evaluation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "method": {"const": "local_human_attestation_v1"},
    "attestor_kind": {"enum": ["HUMAN_REPOSITORY_OWNER", "CODING_MODEL", "UNKNOWN"]},
    "decision": {"enum": ["OPEN", "CLOSED"]},
    "attested_at": {"type": "string"},
    "expires_at": {"type": "string"}
  }
}
